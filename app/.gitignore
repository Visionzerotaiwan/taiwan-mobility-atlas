# Capacitor scaffold — generated/large artifacts are not versioned.
# Regenerate the native projects any time with `bash setup.sh` (or `npx cap add ios|android`).
node_modules/
package-lock.json

# Native projects are generated by `npx cap add …`.
# After you customise signing / Info.plist / build.gradle, remove the two lines
# below and commit ios/ and android/ so your customisations are tracked.
ios/
android/

# Build output & noise
dist/
*.log
.DS_Store
.gradle/
.env
*.keystore
*.jks

# @capacitor/assets generated PWA output (regenerate with `npm run assets`)
icons/
www/manifest.json
www/icons/
